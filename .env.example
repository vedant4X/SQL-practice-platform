# ==========================================
# Quro SQL Platform Configuration
# ==========================================

# Environment
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# ==========================================
# 1. Application Database (PostgreSQL - Neon / Supabase / AWS RDS / Docker)
# ==========================================
# For Vercel production: Use pooled connection string with sslmode=require
# Example Neon: postgresql://user:pass@ep-cool-project-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# In local Docker: postgresql://app_admin:app_secure_password_dev_123@localhost:5432/sql_platform_app
DATABASE_URL=postgresql://app_admin:app_secure_password_dev_123@localhost:5432/sql_platform_app

# ==========================================
# 2. Authentication, Session & OTP Security (Server-side Only)
# ==========================================
# Strong random 32+ character secrets (e.g. openssl rand -base64 32)
SESSION_SECRET=super_secret_session_encryption_key_at_least_32_chars_long_12345
SESSION_MAX_AGE_SECONDS=604800 # 7 days
OTP_HMAC_SECRET=super_secret_otp_hmac_key_at_least_32_chars_long_67890

# Optional Passwordless Login flow via email code: true | false
AUTH_OTP_LOGIN_ENABLED=false

# Secured endpoint token for Vercel Cron cleanup job (/api/v1/cron/cleanup)
CRON_SECRET=super_secret_cron_job_auth_bearer_token_xyz987

# ==========================================
# 3. Transactional Email Delivery (OTP & Password Reset)
# ==========================================
# Provider: 'resend' | 'brevo' | 'console' (default fallback in dev)
# NOTE: In production, verify your sending domain (SPF/DKIM) in provider dashboard.
# Unverified domains may only deliver to the account owner's email address.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
EMAIL_FROM=Quro SQL <noreply@yourdomain.com>

# ==========================================
# 4. MySQL 8.4 Sandbox Database Configuration
# ==========================================
# In local dev: run .\run-mysql.bat or MySQL daemon on port 3307
# In production on Vercel: configure hosted MySQL (Aiven, TiDB Cloud, etc.)
# If MYSQL_SANDBOX_HOST is omitted in production, MySQL track gracefully reports unavailable.
MYSQL_SANDBOX_HOST=127.0.0.1
MYSQL_SANDBOX_PORT=3307
MYSQL_SANDBOX_ADMIN_USER=root
MYSQL_SANDBOX_ADMIN_PASSWORD=
MYSQL_SANDBOX_RO_USER=sandbox_ro
MYSQL_SANDBOX_RO_PASSWORD=sandbox_ro_pass
MYSQL_SANDBOX_RW_USER=sandbox_rw
MYSQL_SANDBOX_RW_PASSWORD=sandbox_rw_pass
MYSQL_SANDBOX_SSL=false

# ==========================================
# 5. Dedicated Execution Database (Optional External PostgreSQL)
# ==========================================
EXECUTION_ENGINE_MODE=embedded
EXECUTION_DB_URL=postgresql://sandbox_readonly:sandbox_ro_password_dev@localhost:5433/sandbox_exec
EXECUTION_DB_ADMIN_URL=postgresql://exec_admin:exec_secure_password_dev_456@localhost:5433/sandbox_exec

# Sandbox Limits
STATEMENT_TIMEOUT_MS=5000
MAX_ROW_LIMIT=1000
MAX_QUERY_LENGTH=10000
